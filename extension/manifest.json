{
  "manifest_version": 3,
  "name": "红龙 Переводчик — перевод в чатах",
  "short_name": "红龙 Переводчик",
  "description": "Выдели текст в любом чате — получи иероглифы, пиньинь и озвучку. Вставка обратно в поле ввода. Только для аккаунтов HONGLONG.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "红龙 Переводчик",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://honglong.nexusbots.ru/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/pinyin-pro.js", "content/chat.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://honglong.nexusbots.ru/*",
        "http://localhost:3000/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/card.css", "fonts/*.woff2", "eva/eva.jpg"],
      "matches": ["<all_urls>"]
    }
  ]
}
